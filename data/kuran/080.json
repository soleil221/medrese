{"no":80,"ayetler":[{"n":1,"ar":"عَبَسَ وَتَوَلَّىٰٓ","tr":"(Peygamber), yüzünü ekşitti ve geri döndü."},{"n":2,"ar":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","tr":"Âmanın kendisine gelmesinden ötürü"},{"n":3,"ar":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","tr":"Belki o temizlenecek,"},{"n":4,"ar":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","tr":"Yahut öğüt alacak da o öğüt ona fayda verecek."},{"n":5,"ar":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","tr":"Kendini (sana) muhtaç görmeyene gelince,"},{"n":6,"ar":"فَأَنتَ لَهُۥ تَصَدَّىٰ","tr":"Sen ona yöneliyorsun,"},{"n":7,"ar":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","tr":"Oysa ki onun temizlenip arınmasından sen sorumlu değilsin."},{"n":8,"ar":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","tr":"Fakat koşarak sana gelen,"},{"n":9,"ar":"وَهُوَ يَخۡشَىٰ","tr":"Ve (Allah'tan) korkarak gelenle,"},{"n":10,"ar":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","tr":"Sen onunla ilgilenmiyorsun."},{"n":11,"ar":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ","tr":"Hayır! Şüphesiz bunlar bir öğüttür,"},{"n":12,"ar":"فَمَن شَآءَ ذَكَرَهُۥ","tr":"Dileyen ondan (Kur'an'dan) öğüt alır,"},{"n":13,"ar":"فِي صُحُفٖ مُّكَرَّمَةٖ","tr":"O, değerli sahifelerdir,"},{"n":14,"ar":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","tr":"Tertemiz kılınmış, yüce makamlara kaldırılmış mukaddes sahifelerde,"},{"n":15,"ar":"بِأَيۡدِي سَفَرَةٖ","tr":"Katiplerin ellerindedir,"},{"n":16,"ar":"كِرَامِۭ بَرَرَةٖ","tr":"Değerli ve güvenilir katiplerin."},{"n":17,"ar":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ","tr":"Kahrolası insan! Ne inkarcıdır!"},{"n":18,"ar":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","tr":"Allah onu neden yarattı?"},{"n":19,"ar":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","tr":"Bir nutfeden (spermadan) yarattı da ona şekil verdi."},{"n":20,"ar":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","tr":"Sonra ona yolu kolaylaştırdı."},{"n":21,"ar":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","tr":"Sonra onun canını aldı ve kabre soktu."},{"n":22,"ar":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","tr":"Sonra dilediği bir vakitte onu yeniden diriltir."},{"n":23,"ar":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ","tr":"Hayır! (İnsan) Allah'ın emrettiğini yapmadı."},{"n":24,"ar":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","tr":"İnsan, yediğine bir baksın!"},{"n":25,"ar":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا","tr":"Yağmurlar yağdırdık,"},{"n":26,"ar":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا","tr":"Sonra toprağı göz göz yardık,"},{"n":27,"ar":"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","tr":"Bu suretle orada ekinler bitirdik,"},{"n":28,"ar":"وَعِنَبٗا وَقَضۡبٗا","tr":"Üzümler, yoncalar,"},{"n":29,"ar":"وَزَيۡتُونٗا وَنَخۡلٗا","tr":"Zeytinlikler, hurmalıklar,"},{"n":30,"ar":"وَحَدَآئِقَ غُلۡبٗا","tr":"İri ve sık ağaçlı bahçeler,"},{"n":31,"ar":"وَفَٰكِهَةٗ وَأَبّٗا","tr":"Meyveler ve çayırlar bitirdik."},{"n":32,"ar":"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","tr":"(Bütün bunlar) sizi ve hayvanlarınızı yararlandırmak içindir."},{"n":33,"ar":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","tr":"Kulakları sağır eden o ses geldiğinde,"},{"n":34,"ar":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ","tr":"İşte o gün kişi kardeşinden, kaçar."},{"n":35,"ar":"وَأُمِّهِۦ وَأَبِيهِ","tr":"Annesinden, babasından,"},{"n":36,"ar":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","tr":"Eşinden ve çocuklarından."},{"n":37,"ar":"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ","tr":"O gün, herkesin kendine yetip artacak bir derdi vardır."},{"n":38,"ar":"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","tr":"O gün bir takım yüzler parıl parıl,"},{"n":39,"ar":"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","tr":"Güler ve sevinir."},{"n":40,"ar":"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","tr":"Yine o gün birtakım yüzleri de keder bürümüş,"},{"n":41,"ar":"تَرۡهَقُهَا قَتَرَةٌ","tr":"Hüzünden kapkara kesilmiştir."},{"n":42,"ar":"أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","tr":"İşte bunlar kafirlerdir, günahkarlardır."}]}