{"no":109,"ayetler":[{"n":1,"ar":"قُلۡ يَـٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","tr":"Ey Muhammed! De ki: \"Ey kafirler!"},{"n":2,"ar":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","tr":"\"Ben sizin taptıklarınıza tapmam.\""},{"n":3,"ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","tr":"\"Benim taptıgıma da sizler tapmazsınız.\""},{"n":4,"ar":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","tr":"\"Ben de sizin taptığınıza tapacak dağilim.\""},{"n":5,"ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","tr":"\"Benim taptığıma da sizler tapmıyorsunuz.\""},{"n":6,"ar":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","tr":"\"Sizin dininiz size, benim dinim banadır.\""}]}