{"no":114,"ayetler":[{"n":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"De ki: Sığınırım ben insanların Rabbine,"},{"n":2,"ar":"مَلِكِ ٱلنَّاسِ","tr":"İnsanların Melikine (mutlak sahip ve hakimine),"},{"n":3,"ar":"إِلَٰهِ ٱلنَّاسِ","tr":"İnsanların İlahına."},{"n":4,"ar":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","tr":"O sinsi vesvesenin şerrinden,"},{"n":5,"ar":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","tr":"O ki insanların göğüslerine (kötü düşünceler)fısıldar."},{"n":6,"ar":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","tr":"Gerek cinlerden, gerek insanlardan(olan bütün vesvesecilerin şerrinden Allah'a sığınırım!"}]}