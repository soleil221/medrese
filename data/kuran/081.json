{"no":81,"ayetler":[{"n":1,"ar":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ","tr":"Güneş katlanıp dürüldüğünde,"},{"n":2,"ar":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ","tr":"Yıldızlar (kararıp) döküldüğünde,"},{"n":3,"ar":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ","tr":"Dağlar (sallanıp) yürütüldüğünde,"},{"n":4,"ar":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ","tr":"Gebe develer salıverildiğinde,"},{"n":5,"ar":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ","tr":"Vahşi hayvanlar toplanıp bir araya getirildiğinde,"},{"n":6,"ar":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ","tr":"Denizler kaynatıldığında,"},{"n":7,"ar":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ","tr":"Ruhlar (bedenlerle) birleştirildiğinde,"},{"n":8,"ar":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ","tr":"Diri diri toprağa gömülen kıza, sorulduğunda,"},{"n":9,"ar":"بِأَيِّ ذَنۢبٖ قُتِلَتۡ","tr":"\"Hangi günah sebebiyle öldürüldü? diye."},{"n":10,"ar":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ","tr":"(Amellerin yazılı olduğu) defterler açıldığında,"},{"n":11,"ar":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ","tr":"Gökyüzü sıyrılıp alındığında,"},{"n":12,"ar":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ","tr":"Cehennem tutuşturulduğunda,"},{"n":13,"ar":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ","tr":"Ve cennet yaklaştırıldığında,"},{"n":14,"ar":"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ","tr":"Kişi neler getirdiğini öğrenmiş olacaktır."},{"n":15,"ar":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ","tr":"Şimdi yemin ederim o sinenlere,"},{"n":16,"ar":"ٱلۡجَوَارِ ٱلۡكُنَّسِ","tr":"O akıp akıp yuvasına gidenlere,"},{"n":17,"ar":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ","tr":"Kararmaya yüz tuttuğunda geceye andolsun,"},{"n":18,"ar":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ","tr":"Ağarmaya başladığında sabaha andolsun ki,"},{"n":19,"ar":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","tr":"O (Kur'an), şüphesiz değerli, bir elçinin (Cebrail'in) getirdiği sözdür."},{"n":20,"ar":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ","tr":"O elçi güçlü, Arş'ın sahibi (Allah'ın) katında çok itibarlıdır."},{"n":21,"ar":"مُّطَاعٖ ثَمَّ أَمِينٖ","tr":"O orada sayılan, güvenilen (bir elçi) dir."},{"n":22,"ar":"وَمَا صَاحِبُكُم بِمَجۡنُونٖ","tr":"Arkadaşınız (Muhammed) de mecnun değildir."},{"n":23,"ar":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ","tr":"Andolsun ki, onu (Cebrail'i) apaçık ufukta görmüştür."},{"n":24,"ar":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ","tr":"O, gaybın bilgilerini (sizden) esirgemez."},{"n":25,"ar":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ","tr":"O lanetlenmiş şeytanın sözü de değildir."},{"n":26,"ar":"فَأَيۡنَ تَذۡهَبُونَ","tr":"Hal böyle iken nereye gidiyorsunuz?"},{"n":27,"ar":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ","tr":"O, herkes için, bir öğüttür,"},{"n":28,"ar":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ","tr":"Sizden doğru yolda gitmek isteyenler için de."},{"n":29,"ar":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ","tr":"Alemlerin Rabbi Allah dilemedikçe siz dileyemezsiniz."}]}