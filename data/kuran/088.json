{"no":88,"ayetler":[{"n":1,"ar":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","tr":"(Resulüm!) Dehşeti her şeyi kaplayan kıyametin haberi sana geldi mi?"},{"n":2,"ar":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","tr":"O gün bir takım yüzler zelildir,"},{"n":3,"ar":"عَامِلَةٞ نَّاصِبَةٞ","tr":"Durmadan çalışır, (fakat boşuna) yorulur,"},{"n":4,"ar":"تَصۡلَىٰ نَارًا حَامِيَةٗ","tr":"Kızgın ateşe girer."},{"n":5,"ar":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","tr":"Onlara kaynar su pınarından içirilir."},{"n":6,"ar":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","tr":"Onlar için kuru dikenden başka yemek yoktur,"},{"n":7,"ar":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","tr":"O ise ne besler ne de açlığı giderir."},{"n":8,"ar":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","tr":"O gün bir takım yüzler de vardır ki, mutludurlar,"},{"n":9,"ar":"لِّسَعۡيِهَا رَاضِيَةٞ","tr":"(dünyadaki) çabalarından hoşnut olmuşlardır,"},{"n":10,"ar":"فِي جَنَّةٍ عَالِيَةٖ","tr":"Yüce bir cennettedirler."},{"n":11,"ar":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","tr":"Orada boş bir söz işitmezler."},{"n":12,"ar":"فِيهَا عَيۡنٞ جَارِيَةٞ","tr":"Orada (cennette) devamlı akan bir pınar,"},{"n":13,"ar":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","tr":"Yükseltilmiş tahtlar,"},{"n":14,"ar":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","tr":"Konulmuş kadehler,"},{"n":15,"ar":"وَنَمَارِقُ مَصۡفُوفَةٞ","tr":"Sıra sıra dizilmiş yastıklar,"},{"n":16,"ar":"وَزَرَابِيُّ مَبۡثُوثَةٌ","tr":"Serilmiş halılar vardır."},{"n":17,"ar":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","tr":"(İnsanlar) devenin nasıl yaratıldığına, bakmazlar mı?"},{"n":18,"ar":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","tr":"Göğe bakmıyorlar mı nasıl yükseltilmiş?"},{"n":19,"ar":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","tr":"Dağların nasıl dikildiğine, bakmazlar mı?"},{"n":20,"ar":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","tr":"Yeryüzünün nasıl yayıldığına bir bakmazlar mı?"},{"n":21,"ar":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","tr":"O halde (Resulüm), öğüt ver. Çünkü sen ancak öğüt vericisin."},{"n":22,"ar":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","tr":"Onların üzerinde bir zorba değilsin."},{"n":23,"ar":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","tr":"Ancak yüz çevirir inkar ederse,"},{"n":24,"ar":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","tr":"İşte öylesini Allah en büyük azap ile cezalandırır."},{"n":25,"ar":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","tr":"Şüphesiz onların dönüşü sadece bizedir."},{"n":26,"ar":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","tr":"Sonra onların sorguya çekilmesi de sadece bize aittir."}]}