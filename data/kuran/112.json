{"no":112,"ayetler":[{"n":1,"ar":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","tr":"De ki: O, Allah birdir."},{"n":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tr":"Allah sameddir."},{"n":3,"ar":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","tr":"O, doğurmamış ve doğmamıştır."},{"n":4,"ar":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","tr":"Onun hiçbir dengi yoktur."}]}