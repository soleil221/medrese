{"no":96,"ayetler":[{"n":1,"ar":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","tr":"Yaratan Rabbinin adıyla oku!"},{"n":2,"ar":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","tr":"O, insanı bir aşılanmış yumurtadan yarattı."},{"n":3,"ar":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","tr":"Oku! Rabbin, en büyük kerem sahibidir."},{"n":4,"ar":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","tr":"O Rab ki kalemle (yazmayı) öğretti."},{"n":5,"ar":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","tr":"İnsana bilmedikleri şeyi öğretti."},{"n":6,"ar":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","tr":"Gerçek şu ki, insan azar."},{"n":7,"ar":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","tr":"Kendini kendine yeterli gördüğü için."},{"n":8,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","tr":"Kuşkusuz dönüş Rabbinedir."},{"n":9,"ar":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","tr":"Gördün mü şu men edeni,"},{"n":10,"ar":"عَبۡدًا إِذَا صَلَّىٰٓ","tr":"Namaz kılarken bir kulu (Peygamber'i namazdan)?"},{"n":11,"ar":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","tr":"Gördün mü, ya o (Peygamber) doğru yolda olur,"},{"n":12,"ar":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","tr":"Yahut takvayı emrediyorsa?"},{"n":13,"ar":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","tr":"Ne dersin o (meneden, Peygamber'i) yalanlıyor ve doğru yoldan yüz çeviriyorsa!"},{"n":14,"ar":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","tr":"(Bu adam) Allah'ın, (yaptıklarını) gördüğünü bilmez mi!"},{"n":15,"ar":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","tr":"Hayır, hayır! Eğer vazgeçmezse, derhal onu alnından (perçeminden), yakalarız (cehenneme atarız)."},{"n":16,"ar":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","tr":"O yalancı, günahkar alından (perçemden),"},{"n":17,"ar":"فَلۡيَدۡعُ نَادِيَهُۥ","tr":"O, hemen gidip meclisini (kendi taraftarlarını) çağırsın."},{"n":18,"ar":"سَنَدۡعُ ٱلزَّبَانِيَةَ","tr":"Biz de zebanileri çağıracağız."},{"n":19,"ar":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","tr":"Hayır! Ona uyma! Allah'a secde et ve (yalnızca O'na) yaklaş!"}]}