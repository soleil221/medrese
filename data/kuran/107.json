{"no":107,"ayetler":[{"n":1,"ar":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","tr":"Dini yalan sayanı gördün mü"},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","tr":"Öksüzü kakıştıran, yoksulu doyurmaya yanaşmayan kimse işte odur"},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","tr":"Öksüzü kakıştıran, yoksulu doyurmaya yanaşmayan kimse işte odur"},{"n":4,"ar":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","tr":"Vay o namaz kılanların haline ki"},{"n":5,"ar":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","tr":"Onlar kıldıkları namazdan gafildirler"},{"n":6,"ar":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","tr":"Onlar gösteriş yaparlar"},{"n":7,"ar":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","tr":"Onlar basit şeyleri dahi vermezler"}]}