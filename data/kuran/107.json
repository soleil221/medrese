{"no":107,"ayetler":[{"n":1,"ar":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","tr":"Dini yalanlayanı gördün mü?"},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","tr":"İşte o, yetimi itip kakar;"},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","tr":"Yoksulu doyurmaya teşvik etmez;"},{"n":4,"ar":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","tr":"Yazıklar olsun o namaz kılanlara ki,"},{"n":5,"ar":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","tr":"Onlar namazlarını ciddiye almazlar."},{"n":6,"ar":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","tr":"Onlar gösteriş yapanlardır,"},{"n":7,"ar":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","tr":"Ve hayra da mani olurlar."}]}