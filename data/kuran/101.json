{"no":101,"ayetler":[{"n":1,"ar":"ٱلۡقَارِعَةُ","tr":"Gürültü koparacak olan"},{"n":2,"ar":"مَا ٱلۡقَارِعَةُ","tr":"Nedir o gürültü koparacak olan"},{"n":3,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","tr":"O gürültü koparacak olanın ne olduğunu sen bilir misin"},{"n":4,"ar":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","tr":"O gün insanlar, ateş etrafında çırpınıp dökülen pervaneye dönecekler"},{"n":5,"ar":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","tr":"Dağlar, atılmış renkli yüne benzeyecekler"},{"n":6,"ar":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","tr":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır"},{"n":7,"ar":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","tr":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır"},{"n":8,"ar":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","tr":"Tartıları hafif gelenler ise"},{"n":9,"ar":"فَأُمُّهُۥ هَاوِيَةٞ","tr":"Onların yeri bir çukurdur"},{"n":10,"ar":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","tr":"O çukurun ne olduğunu sen bilir misin"},{"n":11,"ar":"نَارٌ حَامِيَةُۢ","tr":"O, kızgın bir ateştir"}]}