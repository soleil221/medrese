{"no":101,"ayetler":[{"n":1,"ar":"ٱلۡقَارِعَةُ","tr":"Kapı çalan!"},{"n":2,"ar":"مَا ٱلۡقَارِعَةُ","tr":"Nedir o kapı çalan?"},{"n":3,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","tr":"O kapı çalanın ne olduğunu bilir misin?"},{"n":4,"ar":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","tr":"İnsanların, ateşin etrafını sarmış pervaneler gibi olur,"},{"n":5,"ar":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","tr":"Dağların da atılmış renkli yüne dönüştüğü gündür (o Karia!)"},{"n":6,"ar":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","tr":"O gün kimin tartılan ameli ağır gelirse."},{"n":7,"ar":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","tr":"İşte o, hoşnut edici bir yaşayış içinde olur."},{"n":8,"ar":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","tr":"Ameli yeğni olana gelince."},{"n":9,"ar":"فَأُمُّهُۥ هَاوِيَةٞ","tr":"İşte onun anası (yeri, yurdu) Haviye'dir."},{"n":10,"ar":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","tr":"Nedir o (Haviye) bilir misin?"},{"n":11,"ar":"نَارٌ حَامِيَةُۢ","tr":"Kızgın ateş!"}]}